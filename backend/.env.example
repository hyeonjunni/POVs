APP_NAME=Ambient Legacy Backend
API_PREFIX=/api/v1

# Required. Random value of at least 32 bytes; never commit the real value.
JWT_SECRET_KEY=

USE_CLOUD_SQL_CONNECTOR=false
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ambient_legacy
INSTANCE_CONNECTION_NAME=
DB_USER=
DB_PASS=
DB_NAME=
PRIVATE_IP=false

GCP_PROJECT_ID=
GCP_CREDENTIALS_PATH=
GCS_BUCKET_NAME=ambient-legacy
# Deprecated for LEGACY uploads (always local-only); historical GCS read/delete only.
USE_GCS_MEDIA_STORAGE=false

GEMMA_ENDPOINT_URL=http://127.0.0.1:9001/generate
EXAONE_ENDPOINT_URL=http://127.0.0.1:9001/chat
OLLAMA_BASE_URL=http://127.0.0.1:11434
PREFER_OLLAMA_FOR_GEMMA=true
OLLAMA_GEMMA_E2B_MODEL_NAME=gemma4:e2b
OLLAMA_GEMMA_E4B_MODEL_NAME=gemma4:e4b
AI_PROVIDER_TIMEOUT_SECONDS=30

OCR_EXECUTABLE_PATH=
OCR_TIMEOUT_SECONDS=30
OCR_LANGUAGE=kor+eng
STT_EXECUTABLE_PATH=
STT_TIMEOUT_SECONDS=60
STT_LANGUAGE=ko
