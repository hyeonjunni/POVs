# Optional profile shortcuts. Supply actual passwords in ignored .env.local.
# EXPO_PUBLIC values are included in the generated client bundle; use test builds only.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8002/api/v1
# Optional local web preview: route browser requests through the Metro dev proxy.
# Native apps keep EXPO_PUBLIC_API_BASE_URL. Leave these blank outside local preview.
EXPO_PUBLIC_WEB_API_BASE_URL=
AMBIENT_DEV_API_PROXY_TARGET=
EXPO_PUBLIC_ENABLE_PROFILE_LOGIN=false
EXPO_PUBLIC_PROFILE_LOGIN_API_BASE_URL=http://127.0.0.1:8002/api/v1
EXPO_PUBLIC_PROFILE_F1_USERNAME=
EXPO_PUBLIC_PROFILE_F1_PASSWORD=
EXPO_PUBLIC_PROFILE_F2_USERNAME=
EXPO_PUBLIC_PROFILE_F2_PASSWORD=
EXPO_PUBLIC_PROFILE_F3_USERNAME=
EXPO_PUBLIC_PROFILE_F3_PASSWORD=
EXPO_PUBLIC_PROFILE_F4_USERNAME=
EXPO_PUBLIC_PROFILE_F4_PASSWORD=
